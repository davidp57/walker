# --- Python ---
__pycache__/
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.exe

# --- Database (local SQLite POC) ---
*.db
*.sqlite
*.sqlite3
*.devbak

# --- Environment ---
.env
.env.*
!.env.example

# Artifactory credentials — copy from pip.conf.example, never commit
pip.conf

# --- Frontend (Node) ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
# Stray root-level Node artifacts (e.g. if a tool is run from the repo root instead of frontend/)
/node_modules/
/.vite/
pnpm-debug.log*

# --- Docs (MkDocs build output) ---
/site/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Claude Code (personal, not shared) ---
.claude/settings.local.json

# --- Local, employer-specific scripts (Walker stays PwC-agnostic; never commit these) ---
/scripts/local/

# --- Impeccable (design tooling) ---
# design.json (the tokens) IS versioned; critique reports and live-session logs are local run output.
.impeccable/critique/
.impeccable/live/
